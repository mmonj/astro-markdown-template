# ==== base rules ====
# ignore child dirs under public/; child files are still committed
public/*/
# allow this public/static/ to be committed
!public/static/
# ==== end base rules ====

# === project-specific ignores ===
# build output
dist/
# === end project-specific ignores ===

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
